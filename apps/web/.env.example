# Copy to apps/web/.env.local for local development.

# Public URL of the site, used for canonical URLs and Open Graph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server settings (validated at startup in src/server/env.ts)
APP_ENV=local
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://redlance:redlance@127.0.0.1:5432/redlance
REDIS_URL=redis://127.0.0.1:6379
AUTH_MODE=dev
# Generate with: openssl rand -base64 32
DEV_SESSION_SECRET=replace-with-output-of-openssl-rand-base64-32
LOG_LEVEL=debug

# Drafting budget (docs/drafts/README.md §10): today's AI spend on drafts, rewrites and voice
# updates across all users, in USD (UTC day, 0 to 10,000). Alert at the first, pause new drafts
# at the second. The defaults fit about 1,000 users; raise them as the user count grows.
DRAFT_BUDGET_ALERT_USD=40
DRAFT_BUDGET_PAUSE_USD=80

# Alerts (docs/alerts/README.md): the Telegram bot's @username (from @BotFather, ends in "bot").
# Leave empty to turn "Connect Telegram" off.
TELEGRAM_BOT_USERNAME=
