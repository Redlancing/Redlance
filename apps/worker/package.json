{
  "name": "@redlance/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --watch --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env.local --import tsx src/index.ts",
    "eval": "node --env-file-if-exists=.env.local --import tsx test/eval/run.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vertex:check": "node --env-file-if-exists=.env.local --import tsx scripts/vertex-check.ts",
    "ingest:status": "node --env-file-if-exists=.env.local --import tsx src/cli/ingest-status.ts",
    "ingest:plan": "node --env-file-if-exists=.env.local --import tsx src/cli/ingest-plan.ts",
    "match:status": "node --env-file-if-exists=.env.local --import tsx src/cli/match-status.ts",
    "eval:posts": "node --env-file-if-exists=.env.local --import tsx test/eval/posts/run.ts"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "langsmith": "^0.10.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@redlance/core": "*",
    "@redlance/db": "*",
    "@redlance/llm": "*",
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "html-to-text": "^10.0.1",
    "mammoth": "^1.13.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  }
}
