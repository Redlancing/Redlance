# Copy to .env.local. Local defaults.
APP_ENV=local
DATABASE_URL=postgres://redlance:redlance@127.0.0.1:5432/redlance
LOG_LEVEL=info

# Resume imports use Gemini on Vertex AI (there is no offline mode; tests use stubs).
# Sign in once with: gcloud auth application-default login
# Temporary testing fallback instead of the login: a service-account key file kept in
# apps/worker/.secrets/ (gitignored). Remove this line and delete the key when done.
# GOOGLE_APPLICATION_CREDENTIALS=.secrets/vertex-key.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# FAST: post analysis, drafts, rewrites, voice notes, resume Basics and Job types.
# SMART: the resume Skills step only (drafts moved to Flash-Lite on 2026-10-20).
VERTEX_MODEL_FAST=gemini-3.5-flash-lite
VERTEX_MODEL_SMART=gemini-3.8-flash

# Optional locally (raises the GitHub API rate limit); required elsewhere.
GITHUB_TOKEN=

WORKER_CONCURRENCY=4

# Ingestion (docs/ingestion/plan.md). One worker polls Reddit at a time (advisory lock);
# signed-out RSS allows 1 request a minute per IP, so never go below 65000 ms (sooner still got 429s in testing).
INGEST_ENABLED=true
ANALYSIS_ENABLED=true
# Hourly subreddit insights refresh; runs in the worker that holds the poller lock (needs INGEST_ENABLED=true)
INSIGHTS_ENABLED=true
ANALYSIS_DAILY_BUDGET_USD=2
INGEST_MAX_GROUP=80
INGEST_MIN_SPACING_MS=65000
# Cross-post detection: same author, near-identical title and body (body similarity 0.3 to 0.95) within this many hours (1 to 336).
DEDUPE_SIMILARITY=0.8
DEDUPE_WINDOW_HOURS=72
# Matching (docs/matching/plan/): match analysed posts to users. A match is queued for an AI
# re-score at this rule score or above (0 to 100); posts older than MATCH_MAX_AGE_DAYS (1 to 30) are never matched.
MATCHING_ENABLED=true
RESCORE_THRESHOLD=50
MATCH_MAX_AGE_DAYS=7
# AI re-score of strong matches (Flash-Lite, VERTEX_MODEL_FAST), within each plan's daily cap
# (trial 15, standard 15, max 50). Runs only when matching is on. The budget is a daily cap on
# re-score spend across all users, in USD (0 to 1000). Off for the MVP (decided 2026-10-19): the
# feed uses the rule score, and drafting picks the project to cite. While off, nothing is queued.
RESCORE_ENABLED=false
RESCORE_DAILY_BUDGET_USD=5
# An email or u/name for the Reddit User-Agent, so Reddit can reach us.
REDDIT_UA_CONTACT=
# Drafting budget (docs/drafts/README.md §10), the same values as apps/web: today's AI spend on
# drafts, rewrites and voice updates across all users, in USD (UTC day, 0 to 10,000).
# Alert at the first, pause new drafts at the second.
DRAFT_BUDGET_ALERT_USD=40
DRAFT_BUDGET_PAUSE_USD=80
# Drafts (docs/drafts/plan/07-worker-drafts.md): write the comment + first DM the user asked for.
# DRAFT_MODEL (first drafts, "different project") and REWRITE_MODEL
# (style and typed rewrites) default to VERTEX_MODEL_FAST. DRAFT_CONCURRENCY: drafts at once (1-16).
DRAFTS_ENABLED=true
# Voice learning (docs/drafts/plan/09-voice.md): rewrite each user's voice notes every few sends
# (REWRITE_MODEL, a short call); the notes then go into their later drafts.
VOICE_ENABLED=true
DRAFT_MODEL=
REWRITE_MODEL=
DRAFT_CONCURRENCY=4
# Alerts (docs/alerts/README.md section 9): the router decides who gets an alert; the Telegram
# sender and bot run only when a token is set (without one the router records skipped_no_channel).
ALERTS_ENABLED=true
# From @BotFather. Never commit a real token.
TELEGRAM_BOT_TOKEN=
# The bot's username without the @ (for t.me deep links).
TELEGRAM_BOT_USERNAME=
# Bot-wide sends per second, 1 to 30 (Telegram allows about 30).
TELEGRAM_MAX_PER_SECOND=25
# A match older than this many hours is not alerted (1 to 168).
ALERT_MAX_AGE_HOURS=24
# The web app's origin, for the links in messages. Required when TELEGRAM_BOT_TOKEN is set.
# Telegram rejects button links to localhost or an IP address, so with such an origin
# (local dev) alerts send without the Draft reply / Open Redlance buttons; Open post stays.
APP_ORIGIN=
