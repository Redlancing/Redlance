# Copy to .env.local. Local defaults.
APP_ENV=local
DATABASE_URL=postgres://redlance:redlance@127.0.0.1:5432/redlance
LOG_LEVEL=info

# Resume imports use Gemini on Vertex AI (there is no offline mode; tests use stubs).
# Sign in once with: gcloud auth application-default login
# Temporary testing fallback instead of the login: a service-account key file kept in
# apps/worker/.secrets/ (gitignored). Remove this line and delete the key when done.
# GOOGLE_APPLICATION_CREDENTIALS=.secrets/vertex-key.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL_FAST=gemini-3.5-flash-lite
VERTEX_MODEL_SMART=gemini-3.8-flash

# Optional locally (raises the GitHub API rate limit); required elsewhere.
GITHUB_TOKEN=

WORKER_CONCURRENCY=4
